{
  "name": "prism-bastion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm --filter @prism-bastion/web-single build",
    "build:coop": "pnpm build:coop-client && pnpm build:coop-server",
    "build:coop-client": "pnpm --filter @prism-bastion/web-coop build",
    "build:coop-server": "pnpm --filter @prism-bastion/coop-server build",
    "start:coop": "node apps/coop-server/dist/server.mjs",
    "balance:report": "node --import ./scripts/register-typescript.mjs scripts/balance-report.ts",
    "check:cjk": "node scripts/check-cjk.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "dev": "node dev.mjs",
    "dev:coop": "node coop-dev.mjs",
    "format:locales": "node scripts/format-locales.mjs",
    "lint": "eslint .",
    "perf:coop-report": "node --expose-gc --import ./scripts/register-typescript.mjs scripts/coop-capacity-report.ts",
    "perf:report": "node --import ./scripts/register-typescript.mjs scripts/performance-report.ts",
    "thoughts:report": "node --import ./scripts/register-typescript.mjs scripts/thought-choreography-report.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:coop": "playwright test --config playwright.coop.config.ts",
    "test:server:coop": "node scripts/coop-server-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "pnpm check:cjk && pnpm check:locales && pnpm check:boundaries && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:coop && pnpm test:server:coop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
