{
  "name": "prism-bastion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "balance:report": "node --import tsx scripts/balance-report.ts",
    "check:cjk": "node scripts/check-cjk.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "dev": "node dev.mjs",
    "format:locales": "node scripts/format-locales.mjs",
    "lint": "eslint .",
    "perf:report": "node --import tsx scripts/performance-report.ts",
    "thoughts:report": "node --import tsx scripts/thought-choreography-report.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:cjk && npm run check:locales && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "i18next": "^26.4.0",
    "pinyin-pro": "^3.29.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
